// Schema is synced with `prisma db push`, NOT `prisma migrate`.
//
// Two consequences worth knowing before editing this file:
//   * `prisma/migrations/` is executed by nothing. It is a historical record,
//     and it already lags this file by 8 models. Do not add to it.
//   * Anything this schema cannot express — partial (WHERE-clause) unique
//     indexes, Row Level Security — belongs in `prisma/sql/`, which
//     `pnpm db:indexes` applies after every push and `pnpm db:verify` audits.
//     Put it anywhere else and it silently never runs.

generator client {
  provider        = "prisma-client-js"
  // postgresqlExtensions lets `prisma db push`/migrate manage the pgvector
  // extension (declared on the datasource) so the KnowledgeChunk vector column
  // can be created on both Supabase and the local pgvector test container.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─── Identity ────────────────────────────────────────────────────────────────
// Admins and customers are now physically separate tables. There is no shared
// `role` field, so a customer row can never be escalated to admin. Admins have
// their own credential login (see auth.ts "admin" provider); they own no
// learning/payment data.

model Admin {
  id             String    @id @default(cuid())
  username       String    @unique
  email          String?   @unique
  hashedPassword String
  displayName    String?   @map("name")
  // SEC-16: TOTP MFA. `totpSecret` holds a pending or active base32 secret;
  // `totpEnabledAt` is set only once the admin confirms a code, after which the
  // second factor is required at login.
  totpSecret     String?
  totpEnabledAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Customer {
  id               String                   @id @default(cuid())
  userNumber       Int?                     @unique // switch to @default(autoincrement()) on PostgreSQL
  username         String?                  @unique
  email            String?                  @unique
  phone            String?                  @unique
  displayName      String?                  @map("name")
  hashedPassword   String?
  accessTier       String                   @default("FREE")
  stripeCustomerId String?
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  identities       UserIdentity[]
  examSessions     ExamSession[]
  mobileSessions   MobileSession[]
  basicProgress    BasicLessonProgress[]
  advancedProgress AdvancedLessonProgress[]
  payments         Payment[]
  entitlements     Entitlement[]
  refundRequests   RefundRequest[]
  flightReviewBookings FlightReviewBooking[]
  flightReviewCredits  FlightReviewCredit[]
}

model UserIdentity {
  id                String    @id @default(cuid())
  userId            String
  user              Customer  @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model MobileSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      Customer  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model VerificationCode {
  id         String    @id @default(cuid())
  target     String
  channel    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, channel])
}

// SEC-10/11: shared, fixed-window counters for login lockout and endpoint
// throttling. Lives in the DB (not memory) so the limit holds across Vercel's
// stateless instances. `key` encodes the scope, e.g. "login:acct:<email>",
// "login:ip:<ip>", "send-code:ip:<ip>". A row is reset when its window expires.
model RateLimit {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

model ExamSession {
  id               String    @id
  userId           String?
  user             Customer? @relation(fields: [userId], references: [id])
  certLevel        String
  locale           String
  questionIds      String // JSON: string[]
  questionSnapshot String    @default("[]") // JSON: Question[] captured at exam creation; grading/review reads this
  answers          String    @default("{}") // JSON: Record<string, string[]>
  startedAt        DateTime
  expiresAt        DateTime
  submitted        Boolean   @default(false)
  result           String? // JSON: ExamResult
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Payment {
  id                      String   @id @default(cuid())
  userId                  String
  user                    Customer @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String   @unique
  stripePaymentIntentId   String?  @unique
  stripeCustomerId        String?
  product                 String
  amountTotal             Int?
  currency                String?
  status                  String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  refundRequests          RefundRequest[]

  @@index([userId])
  @@index([product])
}

model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  user      Customer  @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   String
  source    String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([product])
  @@unique([userId, product])
}

// A customer-initiated refund request (PRD U5). Refunds are reviewed by a human
// because only a person can weigh whether the thing being refunded was already
// delivered — a review credit that has been consumed is a completed appointment,
// not an unused purchase.
model RefundRequest {
  id        String    @id @default(cuid())
  userId    String
  user      Customer  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId String
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reason    String
  // PENDING → APPROVED → REFUNDING → REFUNDED, or PENDING → REJECTED.
  // REFUNDING exists because some payment methods refund asynchronously: the
  // money is not back yet, so access must not be revoked until it is.
  status    String    @default("PENDING")
  adminNote String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([paymentId])
}

// A record of every transactional email we tried to send (PRD U12).
//
// Delivery failure must never roll back the thing it is reporting — a booking is
// the product, the email is a courtesy — so a failed send is swallowed. Swallowed
// silently, though, it is unrecoverable: nobody knows to resend. Deliberately
// FK-free so the log outlives whatever it describes.
model NotificationLog {
  id         String   @id @default(cuid())
  kind       String // "flight_review_booked" | "flight_review_rescheduled" | "flight_review_cancelled"
  recipient  String
  bookingId  String?
  customerId String?
  status     String // "SENT" | "FAILED"
  error      String?
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([status])
}

model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─── Flight Review booking ───────────────────────────────────────────────────
// Admins publish discrete dated slots (each carrying its own location + examiner);
// a student with an unused review CREDIT books one (PRD U13). Flight Review is a
// consumable, not a permanent entitlement: buying it — or buying the course
// bundle, which includes one — mints a FlightReviewCredit that a booking holds
// and a completed review burns.
//
// A booking row is now permanent history: cancelling sets status = CANCELLED
// rather than deleting, so `slotId @unique` alone can no longer keep a slot
// bookable after a cancellation. Both invariants are enforced by partial unique
// indexes in prisma/sql/ (Prisma cannot declare a WHERE clause on an index):
//   - one BOOKED booking per slot
//   - one BOOKED booking per customer  ← was `customerId @unique`
// `prisma db push` does NOT create them. Run `pnpm db:indexes` after any push,
// in test setup and in production, or the concurrency guarantees silently vanish.

model FlightReviewSlot {
  id            String               @id @default(cuid())
  startsAt      DateTime // stored UTC
  durationMin   Int                  @default(60)
  location      String
  examinerName  String
  examinerEmail String?
  examinerPhone String?
  notes         String?
  status        String                @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  // Many, not one: a cancelled booking stays on the slot as history. Only one of
  // them may be BOOKED at a time — enforced by a partial unique index, see above.
  bookings      FlightReviewBooking[]

  @@index([startsAt])
}

model FlightReviewBooking {
  id          String              @id @default(cuid())
  slotId      String
  slot        FlightReviewSlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status      String              @default("BOOKED") // "BOOKED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  credit      FlightReviewCredit?

  @@index([slotId])
  @@index([customerId])
  @@index([customerId, status])
}

// A one-shot Flight Review credit (PRD U13 §13.2). Its four states are read off
// its own columns — there is deliberately no `creditId` back-pointer on the
// booking, because a >=48h cancellation RELEASES the credit (bookingId → null)
// and a second pointer would then outlive the link it describes:
//   available  bookingId = null, consumedAt = null, revokedAt = null
//   held       bookingId → a BOOKED booking
//   consumed   consumedAt set (review completed, no-show, or a late cancellation)
//   revoked    revokedAt set (refunded)
model FlightReviewCredit {
  id         String               @id @default(cuid())
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source     String // "stripe_checkout" | "course_bundle" | "admin_grant" | "migration"
  paymentId  String? // originating payment; null for admin_grant / migration
  bookingId  String?              @unique
  booking    FlightReviewBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime             @default(now())

  @@index([customerId])
  @@index([paymentId])
}

// ─── Question banks (split by certification level) ───────────────────────────
// Basic and advanced questions live in physically separate banks. There is no
// "BOTH" — every question belongs to exactly one bank. The `certLevel` column is
// retained for app/mapper compatibility and is always equal to the bank's level.

model BasicQuestionBank {
  id          String                @id // "air-law-0001" format — preserves ExamSession refs
  moduleId    String
  certLevel   String                @default("BASIC") // always "BASIC"
  type        String // "SINGLE" | "MULTI"
  selectCount Int
  difficulty  Int
  stemEN      String
  stemZH      String
  explEN      String
  explZH      String
  refEN       String
  refZH       String
  tags        String                @default("[]") // JSON: string[]
  mediaKind   String?
  mediaUrl    String?
  mediaAltEN  String?
  mediaAltZH  String?
  status      String                @default("ACTIVE") // "ACTIVE" | "ARCHIVED"; exam generation only uses ACTIVE
  archivedAt  DateTime?
  options     BasicQuestionOption[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([moduleId])
}

model AdvancedQuestionBank {
  id          String                   @id
  moduleId    String
  certLevel   String                   @default("ADVANCED") // always "ADVANCED"
  type        String
  selectCount Int
  difficulty  Int
  stemEN      String
  stemZH      String
  explEN      String
  explZH      String
  refEN       String
  refZH       String
  tags        String                   @default("[]")
  mediaKind   String?
  mediaUrl    String?
  mediaAltEN  String?
  mediaAltZH  String?
  status      String                   @default("ACTIVE")
  archivedAt  DateTime?
  options     AdvancedQuestionOption[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([moduleId])
}

model BasicQuestionOption {
  id         String            @id @default(cuid())
  questionId String
  optionId   String // "a" | "b" | "c" | "d"
  labelEN    String
  labelZH    String
  isCorrect  Boolean
  question   BasicQuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionId])
  @@index([questionId])
}

model AdvancedQuestionOption {
  id         String               @id @default(cuid())
  questionId String
  optionId   String
  labelEN    String
  labelZH    String
  isCorrect  Boolean
  question   AdvancedQuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionId])
  @@index([questionId])
}

// ─── Checkpoint questions (lesson practice, separate from the exam banks) ─────
// Physically separate from BasicQuestionBank/AdvancedQuestionBank so the public
// checkpoint endpoints can never reach exam answers (SEC-04). Each checkpoint is
// assigned to one lesson via `lessonId` and renders at the bottom of that lesson.
model CheckpointQuestion {
  id          String                     @id // "cp-air-law-0001"
  lessonId    String // assignment target: "${course}/${moduleId}/${slug}"
  course      String // "basic" | "advanced" (denormalized for filtering)
  moduleId    String // denormalized for CMS list filtering
  order       Int                        @default(0) // position among a lesson's checkpoints
  type        String // "SINGLE" | "MULTI"
  selectCount Int
  stemEN      String
  stemZH      String
  explEN      String
  explZH      String
  refEN       String
  refZH       String
  tags        String                     @default("[]") // JSON: string[]
  mediaKind   String?
  mediaUrl    String?
  mediaAltEN  String?
  mediaAltZH  String?
  status      String                     @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  archivedAt  DateTime?
  options     CheckpointQuestionOption[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([lessonId])
  @@index([course, moduleId])
}

model CheckpointQuestionOption {
  id         String             @id @default(cuid())
  questionId String
  optionId   String
  labelEN    String
  labelZH    String
  isCorrect  Boolean
  question   CheckpointQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionId])
  @@index([questionId])
}

// ─── Lessons (split by course) ───────────────────────────────────────────────
// Basic and advanced lessons live in physically separate tables. The `course`
// column is retained for app/mapper compatibility and is always equal to the
// table's course. `lessonId` ("${course}/${moduleId}/${slug}") stays the stable
// external identifier used across the completion UI and as the progress FK.

model BasicLesson {
  id         String                @id @default(cuid())
  lessonId   String                @unique // "${course}/${moduleId}/${slug}"
  course     String                @default("basic") // always "basic"
  moduleId   String
  slug       String
  order      Int
  estMinutes Int
  certLevel  String // "BASIC" | "ADVANCED" | "BOTH" (lesson tag; orthogonal to course)
  access     String // "FREE" | "PAID"
  titleEN    String
  titleZH    String
  bodyEN     String // raw MDX body (frontmatter stripped)
  bodyZH     String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  videoUid          String?
  videoStatus       String?               // "PROCESSING" | "READY" | "ERROR"
  videoDurationSec  Int?
  videoThumbnailUrl String?
  progress          BasicLessonProgress[]

  @@unique([course, moduleId, slug])
  @@index([course, moduleId])
}

model AdvancedLesson {
  id         String                   @id @default(cuid())
  lessonId   String                   @unique
  course     String                   @default("advanced") // always "advanced"
  moduleId   String
  slug       String
  order      Int
  estMinutes Int
  certLevel  String
  access     String
  titleEN    String
  titleZH    String
  bodyEN     String
  bodyZH     String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  videoUid          String?
  videoStatus       String?                  // "PROCESSING" | "READY" | "ERROR"
  videoDurationSec  Int?
  videoThumbnailUrl String?
  progress          AdvancedLessonProgress[]

  @@unique([course, moduleId, slug])
  @@index([course, moduleId])
}

model BasicLessonProgress {
  id          String      @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime    @default(now())
  user        Customer    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      BasicLesson @relation(fields: [lessonId], references: [lessonId], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model AdvancedLessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime       @default(now())
  user        Customer       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      AdvancedLesson @relation(fields: [lessonId], references: [lessonId], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// Remediation kernel — durable state for the auto-fix remediation pipeline.
// An Incident is the deduplicated identity of a production signal; a RemediationRun is one
// lease-guarded workflow cycle whose phase advances via CAS transitions.
model Incident {
  id              String           @id @default(cuid())
  repository      String
  defaultBranch   String
  fingerprint     String
  occurrenceCount Int              @default(1)
  latestPayload   String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  runs            RemediationRun[]
  externalActions ExternalAction[]

  @@unique([repository, defaultBranch, fingerprint])
}

model RemediationRun {
  id             String    @id @default(cuid())
  incidentId     String
  incident       Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  cycle          Int       @default(1)
  phase          String    @default("RECEIVED")
  leaseOwner     String?
  leaseExpiresAt DateTime?
  escalatedAt    DateTime?
  evidence       String? // persisted RepairEvidence JSON (resume buffer for verify/publish)
  target         Json? // immutable repair target, frozen at REPRODUCING→FIXING; resume must match it
  policy         Json? // frozen repair/verify policy, snapshotted at first repair; resume runs under the same rules
  attestation    Json? // black-box attestation state: the BlackBoxRequest (nonce+digests) frozen at VERIFYING→ATTESTING, plus the verified attestation for audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([incidentId, cycle])
  @@index([incidentId])
  @@index([phase, leaseExpiresAt])
}

// A remediation proposal (mock Draft PR). Stable identity per (incident, kind);
// each verified cycle is an append-only version, never rewritten. currentVersion
// is advanced with an atomic GREATEST so concurrent cycles stay monotonic.
model ExternalAction {
  id             String                  @id @default(cuid())
  kind           String // "draft_pr"
  incidentId     String
  incident       Incident                @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  repository     String
  defaultBranch  String
  fingerprint    String
  status         String                  @default("open")
  currentVersion Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  versions       ExternalActionVersion[]

  @@unique([incidentId, kind])
}

model ExternalActionVersion {
  id        String         @id @default(cuid())
  actionId  String
  action    ExternalAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  cycle     Int
  version   Int
  body      String
  patch     String
  evidence  String
  createdAt DateTime       @default(now())

  @@unique([actionId, version])
  @@unique([actionId, cycle])
}

// ─── RAG knowledge base ──────────────────────────────────────────────────────
// Chunked, embedded corpus backing the chat assistant's `search_course_content`
// tool (hybrid semantic + keyword retrieval). Course lessons and externally
// ingested documents share this table, distinguished by `source`. Chunks are
// stored per-locale (EN/ZH separately) so retrieval stays in the reply language.
// `embedding` is a pgvector column (voyage-3.5, 1024-dim); its HNSW cosine index
// is created out-of-band by the reindex script (Prisma can't declare it).
model KnowledgeChunk {
  id         String                       @id @default(cuid())
  source     String // "LESSON" | "DOCUMENT"
  sourceId   String // lessonId, or a document slug
  moduleId   String?
  certLevel  String? // "BASIC" | "ADVANCED" | null
  locale     String // "EN" | "ZH"
  title      String
  content    String // the chunk text
  chunkIndex Int
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@unique([source, sourceId, locale, chunkIndex])
  @@index([locale])
}

// One turn of the study assistant: one user message, one assistant reply, and
// everything the audit could not answer about it from production — what it cost,
// how long it took, which tools it called, and whether it actually finished.
//
// Written once the stream closes, on EVERY path including failure. That matters
// more than it sounds: the route streams, so a turn that dies halfway has already
// sent HTTP 200 and looks like a success to anything watching status codes.
// `completed` is the field that tells the truth, and it is why the row is written
// in a `finally` rather than on the happy path.
//
// `question`/`answer` pass through redact() first (see redact.ts) — a floor, not
// anonymisation. `rating` is the only human signal in the system; without it every
// failure rate is one person's opinion of their own product.
model AssistantTurn {
  id             String @id @default(cuid())
  conversationId String // groups turns into a session; client-supplied, scoped by userId
  turnIndex      Int // 0-based position within the conversation
  userId         String
  locale         String // "EN" | "ZH"

  question     String
  answer       String
  historyTurns Int    @default(0) // prior messages sent with this request — the context-growth signal

  model          String
  stopReason     String?
  truncated      Boolean @default(false) // stop_reason was max_tokens: the answer is cut off
  exhaustedSteps Boolean @default(false) // the model was still calling tools at MAX_STEPS
  timedOut       Boolean @default(false) // the loop's wall-clock budget ran out
  completed      Boolean @default(false) // the stream closed without throwing
  errorKind      String? // constructor name of whatever escaped, when it didn't

  steps     Int    @default(0)
  toolCalls String @default("[]") // JSON array of tool names, in call order

  inputTokens      Int  @default(0)
  outputTokens     Int  @default(0)
  cacheReadTokens  Int  @default(0)
  cacheWriteTokens Int  @default(0)
  costMicroUsd     Int? // null = the model has no price on file, which is not the same as free

  ttftMs  Int? // time to first text delta — what the student actually perceives
  totalMs Int  @default(0)

  rating  Int? // -1 or 1, set later via the feedback route
  ratedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, turnIndex])
  @@index([createdAt])
}
