node_modules/
.next/
dist/
*.log
.DS_Store
coverage/
.worktrees/

# Next.js generated
next-env.d.ts
*.tsbuildinfo

# Prisma local databases
prisma/*.db
prisma/*.db-journal

# Env files — never commit secrets. Only .env.example (the template) is tracked.
.env
.env.*
!.env.example

.vercel

# Sentry
.sentryclirc
.env.sentry-build-plugin

# Database dumps — may contain user/payment data, never commit
*.dump

# Claude Code agent settings — machine-specific tool allowlist / local paths.
# Not for committing (broad command perms shouldn't be a project artifact).
.claude/settings.json
.claude/settings.local.json

# Assistant eval artifacts
scripts/eval/results.json

# Internal docs — kept local only. Only root README.md / README.zh.md and CLAUDE.md are tracked.
*.md
!/README.md
!/README.zh.md
!/CLAUDE.md
# Product & QA documentation IS tracked: the PRD is the source of truth for
# business rules, and the QA assets (test plan, cases, checklists) must stay in
# sync with the code they verify — local-only docs drift (see PRD §11).
!/docs/product/**/*.md
!/docs/qa/**/*.md

# Operational/seed scripts — kept local only (read secrets from env at runtime).
# Not a blanket scripts/ ignore: scripts/eval/* is tracked feature code.
/scripts/create-admin.ts
/scripts/create-customer.ts
/scripts/migrate-checkpoints.ts
/scripts/seed-content.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
